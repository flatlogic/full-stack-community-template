<%
    scalar_fields = @fields.select{|f| ['string', 'date', 'datetime', 'enum', 'int', 'decimal', 'boolean'].include? f['@type']}
%>
const db = require('../models');
const crypto = require('crypto');
const Utils = require('../utils');
<% if '((name))' == 'users' %>
const bcrypt = require('bcrypt');
const config = require('../../config');
const { normalizeEmail } = require('../../auth/email');
const { privateUserFields, publicUserFields } = require('../../auth/userFields');

function editableUserData(input) {
    const data = Object.create(null);
    for (const field of publicUserFields(Object.keys(input))) {
        if (field !== 'emailVerified') data[field] = input[field];
    }
    if (data.email !== undefined) data.email = normalizeEmail(data.email);
    return data;
}
<% end %>

const Sequelize = db.Sequelize;
const Op = Sequelize.Op;

module.exports = class ((Name))DBApi {
    <% if '((name))' == 'users' %>
    static async create(data, options) {
        const currentUser = (options && options.currentUser) || { id: null };
        const transaction = (options && options.transaction) || undefined;
        const input = editableUserData(data.data);
        return db.users.create({
            id: input.id || undefined,
            <% scalar_fields.each do |f| %>
            <%= f['@name'] %>: input.<%= f['@name'] %> ||
                <% if f['@type'] == 'boolean' %>false<% elsif f['@name'] == 'role' %>'user'<% else %>null<% end %>,
            <% end %>
            importHash: input.importHash || null,
            createdById: currentUser.id,
            updatedById: currentUser.id,
        }, { transaction });
    }
    <% end %>

    <% if '((name))' != 'users' %>
    static async create(data, options) {
        const currentUser = (options && options.currentUser) || { id: null };
        const transaction = (options && options.transaction) || undefined;

        const ((name)) = await db.((name)).create(
            {
                id: data.id || undefined,
        <%
      scalar_fields.each_with_index do |f,i|
      %>
        <%=f['@name']%>: data.<%=f['@name']%>
        ||
        <% if f['@type'] == 'boolean' %>false
        <% elsif f['@name'] == 'role' and '((name))' == 'users' %>'user'
        <% else %>null<% end %>
            ,
            <% end %>
            importHash: data.importHash || null,
            createdById: currentUser.id,
            updatedById: currentUser.id,
    },
        { transaction },
    );

        return ((name));
    }
    <% end %>

    static async bulkImport(data, options) {
        const currentUser = (options && options.currentUser) || { id: null };
        const transaction = (options && options.transaction) || undefined;

        <% if '((name))' == 'users' %>
        data = data.map(editableUserData);
        <% end %>
        // Prepare data - wrapping individual data transformations in a map() method
        const ((name))Data = data.map((item, index) => ({
                id: item.id || undefined,
                <% scalar_fields.each_with_index do |f,i| %>
                <%=f['@name']%>: item.<%=f['@name']%>
            ||
            <% if f['@type'] == 'boolean' %>false
        <% elsif f['@name'] == 'role' and '((name))' == 'users' %>'user'
        <% else %>null<% end %>
            ,
            <% end %>
            importHash: item.importHash || null,
            createdById: currentUser.id,
            updatedById: currentUser.id,
            createdAt: new Date(Date.now() + index * 1000),
    }));

        // Bulk create items
        const ((name)) = await db.((name)).bulkCreate(((name))Data, { transaction });

        return ((name));
    }

    static async update(id, data, options) {
        const currentUser = (options && options.currentUser) || {id: null};
        const transaction = (options && options.transaction) || undefined;

        const ((name)) = await db.((name)).findByPk(id, {transaction});
        const updatePayload = {};
        <% if '((name))' == 'users' %>
        const newPassword = data.password;
        data = editableUserData(data);
        <% end %>
        <% scalar_fields.each do |f| %>
        if (data.<%= f['@name'] %> !== undefined) updatePayload.<%= f['@name'] %> = data.<%= f['@name'] %>;
        <% end %>
        <% if '((name))' == 'users' %>
        if (newPassword) {
            updatePayload.password = await bcrypt.hash(newPassword, config.bcrypt.saltRounds);
        }
        if (newPassword || (data.email !== undefined && data.email !== users.email) ||
            (data.disabled !== undefined && data.disabled !== users.disabled)) {
            updatePayload.passwordResetToken = null;
            updatePayload.passwordResetTokenExpiresAt = null;
            updatePayload.emailVerificationToken = null;
            updatePayload.emailVerificationTokenExpiresAt = null;
        }
        <% end %>
        updatePayload.updatedById = currentUser.id;

        await ((name)).update(updatePayload, {transaction});

        return ((name));
    }

    static async deleteByIds(ids, options) {
        const currentUser = (options && options.currentUser) || { id: null };
        const transaction = (options && options.transaction) || undefined;

        const ((name)) = await db.((name)).findAll({
            where: {
                id: {
                    [Op.in]: ids,
                },
            },
            transaction,
        });

        await db.sequelize.transaction(async (transaction) => {
            for (const record of ((name))) {
                await record.update(
                    {deletedBy: currentUser.id},
                    {transaction}
                );
            }
            for (const record of ((name))) {
                await record.destroy({transaction});
            }
        });


        return ((name));
    }

    static async remove(id, options) {
        const currentUser = (options && options.currentUser) || {id: null};
        const transaction = (options && options.transaction) || undefined;

        const ((name)) = await db.((name)).findByPk(id, options);

        await ((name)).update({
            deletedBy: currentUser.id
        }, {
            transaction,
        });

        await ((name)).destroy({
            transaction
        });

        return ((name));
    }

    static async findBy(where, options) {
        const transaction = (options && options.transaction) || undefined;

        const ((name)) = await db.((name)).findOne({ where, transaction });

        if (!((name))) {
            return ((name));
        }

        const output = ((name)).get({plain: true});

        return output;
    }

    <% if '((name))' == 'users' %>
    static async findForAuthentication(where, options = {}) {
        return db.users.unscoped().findOne({
            where,
            attributes: ['id', 'email', 'disabled', 'emailVerified', 'password'],
            transaction: options.transaction,
        });
    }
    <% end %>

    static async findAll(filter, options) {
        <% if '((name))' == 'users' %>
        filter = { ...filter };
        for (const field of privateUserFields) {
            delete filter[field];
            delete filter[field + 'Range'];
        }
        if (privateUserFields.includes(filter.field)) delete filter.field;
        <% end %>
        const limit = filter.limit || 0;
        let offset = 0;
        let where = {};
        const currentPage = +filter.page;

        const user = (options && options.currentUser) || null;

        offset = currentPage * limit;

        const orderBy = null;

        const transaction = (options && options.transaction) || undefined;

        let include = [];

        if (filter) {
            if (filter.id) {
                where = {
                    ...where,
                    ['id']: Utils.uuid(filter.id),
                };
            }

            <%
                form_fields = @fields.select{|f| f['@type'] == 'string' }
                form_fields.each_with_index do |f,i|
            %>
                if (filter.<%=f['@name']%>) {
                    where = {
                        ...where,
                        [Op.and]: Utils.ilike(
                            '((name))',
                            '<%=f['@name']%>',
                            filter.<%=f['@name']%>,
                        ),
                    };
                }
            <% end %>


            <%
                form_fields = @fields.select{|f| ['int', 'decimal', 'date', 'datetime'].include? f['@type'] }
                form_fields.each_with_index do |f,i|
            %>
            if (filter.<%=f['@name']%>Range) {
                const [start, end] = filter.<%=f['@name']%>Range;

                if (start !== undefined && start !== null && start !== '') {
                    where = {
                        ...where,
                    <%=f['@name']%>: {
                    ...where.<%=f['@name']%>,
                            [Op.gte]: start,
                    },
                };
                }

                if (end !== undefined && end !== null && end !== '') {
                    where = {
                        ...where,
                    <%=f['@name']%>: {
                    ...where.<%=f['@name']%>,
                            [Op.lte]: end,
                    },
                };
                }
            }
            <% end %>

            if (filter.active !== undefined) {
                where = {
                    ...where,
                    active: filter.active === true || filter.active === 'true'
                };
            }

            <%
                form_fields = @fields.select{|f| f['@type'] == 'enum' or f['@type'] == 'boolean'}
                form_fields.each_with_index do |f,i|
            %>
            if (filter.<%=f['@name']%>) {
                where = {
                    ...where,
                <%=f['@name']%>: filter.<%=f['@name']%>,
            };
            }
            <% end %>

            if (filter.createdAtRange) {
                const [start, end] = filter.createdAtRange;

                if (start !== undefined && start !== null && start !== '') {
                    where = {
                        ...where,
                        ['createdAt']: {
                            ...where.createdAt,
                            [Op.gte]: start,
                        },
                    };
                }

                if (end !== undefined && end !== null && end !== '') {
                    where = {
                        ...where,
                        ['createdAt']: {
                            ...where.createdAt,
                            [Op.lte]: end,
                        },
                    };
                }
            }
        }


        const queryOptions = {
            where,
            include,
            distinct: true,
            order: filter.field && filter.sort
                ? [[filter.field, filter.sort]]
                : [['createdAt', 'desc']],
            transaction: options?.transaction,
            logging: console.log
        };

        if (!options?.countOnly) {
            queryOptions.limit = limit ? Number(limit) : undefined;
            queryOptions.offset = offset ? Number(offset) : undefined;
        }

        try {
            const { rows, count } = await db.((name)).findAndCountAll(queryOptions);

            return {
                rows: options?.countOnly ? [] : rows,
                count: count
            };
        } catch (error) {
            console.error('Error executing query:', error);
            throw error;
        }
    }

    static async findAllAutocomplete(query, limit, offset) {
        <% if '((name))' == 'users' %>
        const labelField = publicUserFields(['<%= @entity['@show_field'].present? ? @entity['@show_field'] : 'id' %>'])[0] || 'id';
        <% else %>
        const labelField = '<%= @entity['@show_field'].present? ? @entity['@show_field'] : 'id' %>';
        <% end %>
        let where = {};

        if (query) {
            where = {
                [Op.or]: [
                    { ['id']: Utils.uuid(query) },
                    Utils.ilike(
                        '((name))',
                        labelField,
                        query,
                    ),
                ],
            };
        }

        const records = await db.((name)).findAll({
            attributes: [ 'id', labelField ],
            where,
            limit: limit ? Number(limit) : undefined,
            offset: offset ? Number(offset) : undefined,
            orderBy: [[labelField, 'ASC']],
        });

        return records.map((record) => ({
            id: record.id,
            label: record[labelField],
        }));
    }

    <% if '((name))' == 'users' %>
    static async createFromAuth(data, options) {
        const { transaction } = options;
        const id = crypto.randomUUID();
        const values = {
            id,
            authenticationUid: id,
            email: data.email,
            firstName: data.firstName,
            emailVerified: false,
            password: data.password,
        };
        const roleAssociation = db.users.associations.app_role;
        if (roleAssociation) {
            const role = await roleAssociation.target.findOne({
                where: { name: config.roles.user }, transaction,
            });
            if (role) {
                values[roleAssociation.foreignKey] = role.id;
            }
        }
        await db.users.create(values, { transaction, logging: false });
        return { id, email: data.email };
    }

    static async updatePassword(id, previousHash, password) {
        const [count] = await db.users.update({
            password,
            authenticationUid: id,
            passwordResetToken: null,
            passwordResetTokenExpiresAt: null,
            emailVerificationToken: null,
            emailVerificationTokenExpiresAt: null,
            updatedById: id,
        }, { where: { id, disabled: false, password: previousHash }, logging: false });
        return count === 1;
    }

    static async issueAccountToken(purpose, email, options = {}) {
        const field = purpose === 'verification' ? 'emailVerificationToken' : 'passwordResetToken';
        const token = crypto.randomBytes(32).toString('hex');
        const digest = crypto.createHash('sha256').update(token).digest('hex');
        const where = { email, disabled: false };
        if (purpose === 'verification') {
            where.emailVerified = false;
        }
        const [count] = await db.users.update({
            [field]: digest,
            [field + 'ExpiresAt']: new Date(Date.now() + 60 * 60 * 1000),
        }, { where, transaction: options.transaction, logging: false });
        return count === 1 ? token : null;
    }

    static accountTokenFilter(field, token) {
        if (typeof token !== 'string' || !/^[a-f0-9]{64}$/.test(token)) {
            return null;
        }
        return {
            disabled: false,
            [field]: crypto.createHash('sha256').update(token).digest('hex'),
            [field + 'ExpiresAt']: { [Op.gt]: new Date() },
        };
    }

    static async findPasswordResetUser(token) {
        const where = this.accountTokenFilter('passwordResetToken', token);
        if (!where) {
            return null;
        }
        return db.users.findOne({ where, attributes: ['id'], logging: false });
    }

    static async consumeAccountToken(purpose, token, changes) {
        const field = purpose === 'verification' ? 'emailVerificationToken' : 'passwordResetToken';
        const where = this.accountTokenFilter(field, token);
        if (!where) {
            return false;
        }
        const [count] = await db.users.update({
            ...changes,
            [field]: null,
            [field + 'ExpiresAt']: null,
        }, { where, logging: false });
        return count === 1;
    }
    <% end %>
};
