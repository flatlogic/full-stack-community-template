const UsersDBApi = require('../db/api/users');
const ValidationError = require('./notifications/errors/validation');
const ForbiddenError = require('./notifications/errors/forbidden');
const bcrypt = require('bcrypt');
const config = require('../config');
const helpers = require('../helpers');
const db = require('../db/models');
const { normalizeEmail, sendAccountEmail } = require('../auth/email');

async function hashPassword(password) {
  if (typeof password !== 'string' || !password.length || Buffer.byteLength(password) > 72) {
    throw new ValidationError('auth.weakPassword');
  }
  return bcrypt.hash(password, config.bcrypt.saltRounds);
}

class Auth {
  static async signup(address, password) {
    const email = normalizeEmail(address);
    if (await UsersDBApi.findBy({ email })) {
      throw new ValidationError('auth.emailAlreadyInUse');
    }

    const hashedPassword = await hashPassword(password);
    try {
      await db.sequelize.transaction(async (transaction) => {
        await UsersDBApi.createFromAuth({
          email,
          firstName: email.split('@')[0],
          password: hashedPassword,
        }, { transaction });
        await this.sendEmailAddressVerificationEmail(email, { transaction });
      });
    } catch (error) {
      if (error instanceof db.Sequelize.UniqueConstraintError) {
        throw new ValidationError('auth.emailAlreadyInUse');
      }
      throw error;
    }
    return true;
  }

  static async signin(address, password) {
    const email = normalizeEmail(address);
    const user = await UsersDBApi.findForAuthentication({ email });

    if (!user) {
      throw new ValidationError(
        'auth.userNotFound',
      );
    }

    if (user.disabled) {
      throw new ValidationError(
        'auth.userDisabled',
      );
    }

    if (!user.password || typeof password !== 'string') {
      throw new ValidationError(
        'auth.wrongPassword',
      );
    }

    if (!user.emailVerified) {
      throw new ValidationError(
        'auth.userNotVerified',
      );
    }

    const passwordsMatch = await bcrypt.compare(
      password,
      user.password,
    );

    if (!passwordsMatch) {
      throw new ValidationError(
        'auth.wrongPassword',
      );
    }

    const data = {
      user: {
        id: user.id,
        email: user.email
      }
    };

    return helpers.jwtSign(data);
  }

  static async sendEmailAddressVerificationEmail(address, options = {}) {
    const email = normalizeEmail(address);
    const token = await UsersDBApi.issueAccountToken('verification', email, options);
    if (token) {
      await sendAccountEmail(email, 'verification', token);
    }
  }

  static async sendPasswordResetEmail(address, type = 'reset') {
    const email = normalizeEmail(address);
    await db.sequelize.transaction(async (transaction) => {
      const token = await UsersDBApi.issueAccountToken('password', email, { transaction });
      if (token) {
        await sendAccountEmail(email, type, token);
      }
    });
  }

  static async verifyEmail(token) {
    const verified = await UsersDBApi.consumeAccountToken('verification', token, { emailVerified: true });
    if (!verified) {
      throw new ValidationError('auth.emailAddressVerificationEmail.invalidToken');
    }
    return true;
  }

  static async passwordUpdate(currentPassword, newPassword, options) {
    const currentUser = options.currentUser || null;
    if (!currentUser) {
      throw new ForbiddenError();
    }

    const credentials = await UsersDBApi.findForAuthentication({ id: currentUser.id });
    const currentPasswordMatch = credentials && credentials.password && typeof currentPassword === 'string' && await bcrypt.compare(
      currentPassword,
      credentials.password,
    );

    if (!currentPasswordMatch) {
      throw new ValidationError(
        'auth.wrongPassword'
      )
    }

    const hashedPassword = await hashPassword(newPassword);
    const newPasswordMatch = await bcrypt.compare(
      newPassword,
      credentials.password,
    );

    if (newPasswordMatch) {
      throw new ValidationError(
        'auth.passwordUpdate.samePassword'
      )
    }

    const updated = await UsersDBApi.updatePassword(currentUser.id, credentials.password, hashedPassword);
    if (!updated) {
      throw new ValidationError('auth.wrongPassword');
    }
    return true;
  }

  static async passwordReset(token, password) {
    const user = await UsersDBApi.findPasswordResetUser(token);
    if (!user) {
      throw new ValidationError('auth.passwordReset.invalidToken');
    }
    const hashedPassword = await hashPassword(password);
    const updated = await UsersDBApi.consumeAccountToken('password', token, {
      password: hashedPassword,
      authenticationUid: user.id,
      emailVerified: true,
      emailVerificationToken: null,
      emailVerificationTokenExpiresAt: null,
    });
    if (!updated) {
      throw new ValidationError('auth.passwordReset.invalidToken');
    }
    return true;
  }

  static async updateProfile(data, currentUser) {
    const { firstName, lastName, phoneNumber, avatar } = data;
    await db.sequelize.transaction(async (transaction) => {
      await UsersDBApi.update(currentUser.id, { firstName, lastName, phoneNumber, avatar }, {
        currentUser,
        transaction,
      });
    });
  }
}

module.exports = Auth;
