const db = require('../db/models');
const { publicUserFields } = require('../auth/userFields');
const ValidationError = require('./notifications/errors/validation');

const Sequelize = db.Sequelize;
const Op = Sequelize.Op;

<% if @schema['project']['@advanced_roles_permissions'] %>
async function searchPermissions(currentUser) {
  const user = await db.users.findByPk(currentUser.id);
  const permissions = new Set();
  if (user && db.users.associations.custom_permissions) {
    const direct = await user.getCustom_permissions();
    for (const item of direct) permissions.add(item.name);
  }
  if (user && db.users.associations.app_role) {
    const role = await user.getApp_role();
    if (role && db.roles.associations.permissions) {
      const inherited = await role.getPermissions();
      for (const item of inherited) permissions.add(item.name);
    }
  }
  return permissions;
}
<% end %>

module.exports = class SearchService {
  static async search(searchQuery, currentUser) {
    try {
      if (!searchQuery) {
        throw new ValidationError('iam.errors.searchQueryRequired');
      }
      const tableColumns = {
        <% @entities.each do |e| %>
          <% next if ['roles', 'permissions'].include?(e['@name']) %>
          <% form_fields = e['fields'].select { |f| f['@show_in_table'] && f['@type'] == 'string'  } %>

          <% unless form_fields.empty? %>
            "<%= e['@name'] %>": [
              <% form_fields.each_with_index do |f| %>
                "<%= f['@name'] %>",
              <% end %>
            ],
          <% end %>
        <% end %>
      };
      const columnsInt = {
        <% @entities.each do |e| %>
          <% next if ['roles', 'permissions'].include?(e['@name']) %>
          <% form_fields = e['fields'].select { |f| f['@show_in_table'] &&( f['@type'] == 'int' or f['@type'] == 'decimal') } %>
          <% unless form_fields.empty? %>
            "<%= e['@name'] %>": [
              <% form_fields.each_with_index do |f| %>
                "<%= f['@name'] %>",
              <% end %>
            ],
          <% end %>
        <% end %>
      };

      if (!currentUser) throw new ValidationError('auth.unauthorized');
      <% if @schema['project']['@advanced_roles_permissions'] %>
      const permissions = await searchPermissions(currentUser);
      <% end %>

      let allFoundRecords = [];

      for (const tableName in tableColumns) {
        if (tableColumns.hasOwnProperty(tableName)) {
          const attributesToSearch = tableName === 'users' ? publicUserFields(tableColumns.users) : tableColumns[tableName];
          const intColumns = columnsInt[tableName] || [];
          const attributesIntToSearch = tableName === 'users' ? publicUserFields(intColumns) : intColumns;
          const whereCondition = {
            [Op.or]: [
              ...attributesToSearch.map(attribute => ({
                [attribute]: {
                  [Op.<%= @schema['project']['@db'] == 'mysql' ? 'like'  : 'iLike' %>] : `%${searchQuery}%`,
                },
              })),
              ...attributesIntToSearch.map(attribute => (
                Sequelize.where(
                  Sequelize.cast(Sequelize.col(`${tableName}.${attribute}`), '<%= @schema['project']['@db'] == 'mysql' ? 'CHAR'  : 'varchar' %>'),
                  { [Op.<%= @schema['project']['@db'] == 'mysql' ? 'like'  : 'iLike' %>]: `%${searchQuery}%` }
                )
              )),
            ],
          };

          <% if @schema['project']['@advanced_roles_permissions'] %>
          if (!permissions.has(`READ_${tableName.toUpperCase()}`)) continue;
          <% end %>

          const foundRecords = await db[tableName].findAll({
            where: whereCondition,
            attributes: [...attributesToSearch, 'id', ...attributesIntToSearch],
          });
      
          const modifiedRecords = foundRecords.map((record) => {
            const matchAttribute = [];
 
            for (const attribute of attributesToSearch) {
              if (record[attribute]?.toLowerCase()?.includes(searchQuery.toLowerCase())) {
                matchAttribute.push(attribute);
              }
            }

            for (const attribute of attributesIntToSearch) {
              const castedValue = String(record[attribute]);
              if (castedValue && castedValue.toLowerCase().includes(searchQuery.toLowerCase())) {
                matchAttribute.push(attribute);
              }
            }
      
            return {
              ...record.get(),
              matchAttribute,
              tableName,
            };
          });

          allFoundRecords = allFoundRecords.concat(modifiedRecords);
        }
      }

      return allFoundRecords;
    } catch (error) {
      throw error;
    }
  }
}