<% require 'digest/md5' %>
<% @app_admin_password = @schema['project']['@project_uuid'] ? @schema['project']['@project_uuid'].split('-').first : 'password' %>
<% @app_user_password = @schema['project']['@project_uuid'] ? @schema['project']['@project_uuid'].split('-').last : 'password' %>
const os = require('os');

const config = {
  gcloud: {
    bucket: "fldemo-files",
    hash: "<%=Digest::MD5.hexdigest(@schema['project']['project_id'].to_s + 'fl_demo')%>"
  },
  bcrypt: {
    saltRounds: 12
  },
  admin_pass: "<%= @app_admin_password %>",
  user_pass: "<%= @app_user_password %>",
  admin_email: "admin@flatlogic.com",
  seededAdminId: '193bf4b5-9f07-4bd5-9a43-e7e41f3e96af',
  providers: {
    LOCAL: 'local',
    GOOGLE: 'google',
    MICROSOFT: 'microsoft'
  },
  secret_key: process.env.SECRET_KEY || '',
  remote: '',
  port: process.env.NODE_ENV === "production" ? "" : "8080",
  hostUI: process.env.NODE_ENV === "production" ? "" : "http://localhost",
  portUI: process.env.NODE_ENV === "production" ? "" : "3000",
  portUIProd: process.env.NODE_ENV === "production" ? "" : ":3000",
  swaggerUI: process.env.NODE_ENV === "production" ? "" : "http://localhost",
  swaggerPort: process.env.NODE_ENV === "production" ? "" : ":8080",

  uploadDir: os.tmpdir(),
  email: {
    from: process.env.EMAIL_FROM || 'app@flatlogic.app',
    host: process.env.EMAIL_HOST || 'email-smtp.us-east-1.amazonaws.com',
    port: Number(process.env.EMAIL_PORT || 587),
    secure: Number(process.env.EMAIL_PORT || 587) === 465,
    requireTLS: process.env.EMAIL_REQUIRE_TLS !== 'false',
    connectionTimeout: 10000,
    greetingTimeout: 10000,
    socketTimeout: 15000,
    auth: process.env.EMAIL_USER ? {
      user: process.env.EMAIL_USER,
      pass: process.env.EMAIL_PASS,
    } : undefined,
  },
  roles: {
    admin: 'Administrator',
    user: 'User',
  },
<% if @schema['project']['@project_uuid'] %>
  project_uuid: '<%= @schema['project']['@project_uuid'] %>',
  flHost: process.env.NODE_ENV === 'production' || process.env.NODE_ENV === 'dev_stage' ? 'https://flatlogic.com/projects' : 'http://localhost:3000/projects',
<% end %>
};

config.host = process.env.NODE_ENV === "production" ? config.remote : "http://localhost";
config.apiUrl = `${config.host}${config.port ? `:${config.port}` : ``}/api`;
config.swaggerUrl = `${config.swaggerUI}${config.swaggerPort}`;
config.uiUrl = `${config.hostUI}${config.portUI ? `:${config.portUI}` : ``}/#`;
config.backUrl = `${config.hostUI}${config.portUI ? `:${config.portUI}` : ``}`;

module.exports = config;
