{<%
  title = @schema['project']['@title']
  fixed_title = title.tr('^A-Za-z0-9_', '').downcase
%>
  "name": "<%= fixed_title.length > 0 ? fixed_title : "generated_app" %>",
  "description": "<%= title %> - template backend",
  "scripts": {
    "start": "npm run db:migrate && npm run db:seed && npm run watch",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:drop": "sequelize-cli db:drop",
    "db:create": "sequelize-cli db:create",
    "watch": "node watcher.js"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "chokidar": "^4.0.3",
    "cors": "2.8.5",
    "csv-parser": "^3.0.0",
    "express": "4.22.3",
    "body-parser": "1.20.9",
    "json2csv": "^5.0.7",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "passport": "^0.7.0",
    "passport-google-oauth2": "^0.2.0",
    "passport-jwt": "^4.0.1",
    "passport-microsoft": "^2.1.0",
    "pg": "^8.23.1",
    "pg-hstore": "2.3.4",
    "validator": "^13.15.26",
    "uuid": "^11.1.1",
    "node-fetch": "^2.7.0",
    "sequelize": "^6.37.8",
    "sequelize-json-schema": "^2.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "tedious": "^18.2.4"
  },
  "resolutions": {
    "sequelize/uuid": "^11.1.1",
    "nodemon/minimatch": "^11.0.1",
    "swagger-jsdoc/glob": "^14.0.2",
    "sequelize-cli/js-beautify/glob": "^14.0.2",
    "sequelize-cli/js-beautify/editorconfig/minimatch": "^11.0.1"
  },
  "engines": {
    "node": ">=22.23.0"
  },
  "private": true,
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
